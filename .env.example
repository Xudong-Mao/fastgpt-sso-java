# FastGPT SSO Java 环境配置示例文件
# 复制此文件为 .env 并根据实际环境修改配置
# .env 文件优先级：系统环境变量 > .env 文件 > application.properties 默认值

# ========== 服务器配置 ==========
SERVER_PORT=8080
SPRING_APPLICATION_NAME=fastgpt-sso-java

# ========== 应用基础配置 ==========
# SSO Provider: test(测试) | weaver(泛微)
APP_SSO_PROVIDER=weaver
# FastGPT 回调认证 Token（用于 /user/list 和 /org/list 接口鉴权）
APP_AUTH_TOKEN=your-auth-token-here
# 是否启用 hostname 重定向
APP_REDIRECT_ENABLED=false
# 重定向目标 hostname（APP_REDIRECT_ENABLED=true 时生效）
APP_HOSTNAME=

# ========== 泛微 Ecology SSO 配置 ==========
# 是否启用泛微 SSO
WEAVER_SSO_ENABLED=true
# CAS 服务端地址（泛微OA地址，必填）
# 如 http://11.41.154.72:8080
WEAVER_SSO_SERVER_URL=http://11.41.154.72:8080
# CAS 登录路径
WEAVER_SSO_LOGIN_PATH=/login/login.jsp
# 应用标识（在泛微统一认证中心注册时分配的 appid）
WEAVER_SSO_APP_ID=fastgpt
# 本服务的外网可达地址（用于CAS回调，必填，泛微需要能访问到此地址）
WEAVER_SSO_SERVER_NAME=http://your-server-host:8080
# 回调接口路径
WEAVER_SSO_CALLBACK_PATH=/login/oauth/callback

# ---------- CAS ticket 主动校验配置 ----------
# ticket 校验接口路径（ticket+service 到 CAS 服务端换取账号）
# 完整地址 = WEAVER_SSO_SERVER_URL + WEAVER_SSO_VALIDATE_PATH
# 兼容返回：JSON(code/data) / CAS 2.0 XML(cas:user) / 纯文本(yes\n账号)
# 标准 CAS 2.0 可用 /sso/serviceValidate
WEAVER_SSO_VALIDATE_PATH=/sso/validate
# 校验请求方式 POST | GET（POST 返回 405/501 时自动改用 GET）
WEAVER_SSO_VALIDATE_METHOD=POST
# 校验接口超时时间（毫秒）
WEAVER_SSO_VALIDATE_TIMEOUT=5000
# 校验接口返回的成功码（仅 JSON 格式：约定 code=0 成功，data 返回用户信息）
WEAVER_SSO_SUCCESS_CODE=0
# 校验失败后重新跳 CAS 登录的最大次数，超过后返回错误，避免无限重定向
WEAVER_SSO_MAX_RETRY=2
# service 回调地址是否携带 redirect_uri/state
# 泛微应用注册要求 service 与注册地址完全一致时设为 false（此时依赖 Session 恢复 redirect_uri）
WEAVER_SSO_SERVICE_INCLUDE_REDIRECT=true
# CAS 登出路径（/login/oauth/logout 会 302 到此地址清理 CAS 会话）
WEAVER_SSO_LOGOUT_PATH=/sso/logout
# CAS 登出后回跳地址（如 FastGPT 登录页），可被请求参数 redirect_uri 覆盖
WEAVER_SSO_LOGOUT_REDIRECT_URL=

# ---------- CAS 账号 → FastGPT 用户 映射表 ----------
# CSV 文件，表头：cas_account,fastgpt_username,member_name,contact,status
# 未映射或 status=0 的 CAS 账号拒绝登录；文件修改后自动重新加载，无需重启
# 示例见 config/user-mapping.example.csv
WEAVER_SSO_USER_MAPPING_FILE=./config/user-mapping.csv
# 是否启用旧的 weaversso.jar Filter 链（默认 false，使用主动校验模式）
WEAVER_SSO_FILTER_ENABLED=false
# 校验接口额外参数（如 appId、timestamp、sign 等，按需在 application.properties 配置）
# weaver.sso.extra-params.appid=xxx

# HR 同步接口认证 Token（泛微OA推送数据时携带的鉴权令牌）
WEAVER_SSO_HR_SYNC_TOKEN=your-hr-sync-token-here

# ========== CAS 返回属性映射（userData 字段名） ==========
# 登录名字段（CAS 校验接口返回 data 中对应的属性名）
WEAVER_SSO_ATTR_USERNAME=loginid
# 姓名字段
WEAVER_SSO_ATTR_MEMBER_NAME=lastname
# 邮箱字段
WEAVER_SSO_ATTR_EMAIL=email
# 手机号字段
WEAVER_SSO_ATTR_MOBILE=mobile

# ========== SAML 配置（按需启用） ==========
# SAML_ENTITY_ID=your-entity-id
# SAML_ASSERTION_CONSUMER_SERVICE_URL=http://localhost:8080/login/saml/assert
# SAML_SINGLE_LOGOUT_SERVICE_URL=http://localhost:8080/logout/saml
# SAML_IDP_METADATA_URL=https://your-idp.com/metadata

# ========== OAuth 配置（按需启用） ==========
# OAUTH_CLIENT_ID=your-oauth-client-id
# OAUTH_CLIENT_SECRET=your-oauth-client-secret
# OAUTH_AUTHORIZATION_URI=https://your-oauth-provider.com/oauth/authorize
# OAUTH_TOKEN_URI=https://your-oauth-provider.com/oauth/token
# OAUTH_USER_INFO_URI=https://your-oauth-provider.com/oauth/userinfo

# ========== 测试配置（APP_SSO_PROVIDER=test 时生效） ==========
# TEST_REDIRECT_URI=http://localhost:3000/callback
# TEST_STATE=test-state-123
# TEST_CODE=test-code-456
# TEST_BASE_URL=http://localhost:8080
